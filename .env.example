# Copy to .env and fill in. .env is gitignored -- never commit it.
#   cp .env.example .env

# ---- Required for everything -------------------------------------------
TYPESAFE_API_KEY=

# Pin this before live trading. "jev-latest" AND the family slug "jev-1.13"
# both float to the newest model, which would silently recalibrate every
# gate threshold in questions.py under you.
TYPESAFE_DEFAULT_MODEL=jev-latest

# ---- Required for paper and live only ----------------------------------
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# ---- Tier 2 / Tier 3 ---------------------------------------------------
# litellm reads the provider key straight from the environment, so the one
# that matters is whichever provider the TIER2/TIER3 model strings name.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Tier 2 runs 3 gatherers per escalation and does the reading, so it wants
# the cheap model. Tier 3 does the judging once.
#   haiku-4-5  $1/$5 per Mtok      opus-5  $5/$25      sonnet-5  $2/$10
# Note: Opus 5.5 / Opus 5 / Sonnet 5 REJECT `temperature` with a 400. swarm.py's
# sampling_kwargs() drops it for those models -- do not add it back.
TIER2_MODEL=anthropic/claude-haiku-4-5
TIER3_MODEL=anthropic/claude-opus-5-5   # $4/$20 per M, verified 2026-09-22

# ---- Sportsbook reference prices (reference.py; optional) -------------
# Free key from https://the-odds-api.com/ (500 credits/month). Without it
# reference.py is inert. It budgets itself: 450/month, 15/day by default.
ODDS_API_KEY=
# ODDS_API_MONTHLY_BUDGET=450
# ODDS_API_DAILY_BUDGET=15

# ---- Mode: shadow | paper | live ---------------------------------------
# shadow  triage only, no account access, no orders
# paper   full pipeline, real balances, logs orders instead of placing them
# live    places real orders
SWARM_MODE=shadow

# Live additionally requires this, deliberately:
# I_UNDERSTAND_THIS_TRADES_REAL_MONEY=yes

LOG_LEVEL=INFO
SHADOW_DB=shadow.db
RISK_LEDGER_DB=ledger.db
HALT_SENTINEL=.halted
